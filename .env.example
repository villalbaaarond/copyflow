# Base de datos PostgreSQL.
# Local: podés usar una base gratis en la nube (Neon) y pegar acá su cadena.
# Producción: la plataforma de hosting la inyecta sola.
DATABASE_URL="postgresql://usuario:clave@host/basededatos?sslmode=require"

# Si tu cadena tiene "-pooler" en el host (es lo normal en Neon), va detrás de
# un pooler y hay que avisarle a Prisma con &pgbouncer=true, si no vas a ver
# errores intermitentes y lentitud. La app lo agrega sola, pero para las
# migraciones (npx prisma migrate) conviene usar la cadena SIN "-pooler".

# Clave para firmar los tokens de sesión. GENERÁ UNA PROPIA EN PRODUCCIÓN:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# Almacenamiento de PDF en la nube (Vercel Blob).
# Si NO está definida, los archivos se guardan en la carpeta local
# "almacenamiento/", que es lo correcto para desarrollo.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
