# Base de datos PostgreSQL.
# Local: podés usar una base gratis en la nube (Neon) y pegar acá su cadena.
# Producción: la plataforma de hosting la inyecta sola.
DATABASE_URL="postgresql://usuario:clave@host/basededatos?sslmode=require"

# Si tu cadena tiene "-pooler" en el host (es lo normal en Neon), va detrás de
# un pooler y hay que avisarle a Prisma con &pgbouncer=true, si no vas a ver
# errores intermitentes y lentitud. La app lo agrega sola, pero para las
# migraciones (npx prisma migrate) conviene usar la cadena SIN "-pooler".

# Clave para firmar los tokens de sesión. GENERÁ UNA PROPIA EN PRODUCCIÓN:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# ---------------------------------------------------------------------------
# PANEL DE DUEÑO DE LA PLATAFORMA (/dueno)
#
# Es el panel para mantener TODAS las fotocopiadoras. Si estas dos variables
# no están, la ruta /dueno directamente no existe (responde 404).
#
# EMAIL_DUENO es el ÚNICO email que puede entrar. Vive acá y no en la base a
# propósito: para tomar el panel no alcanza con escribir en PostgreSQL, hay
# que poder cambiar variables de entorno del servidor.
# EMAIL_DUENO="tu-email@gmail.com"
#
# Secreto de firma PROPIO, distinto del JWT_SECRET de arriba. Que sean
# distintos es lo que impide que una sesión de fotocopiadora valga como
# sesión de plataforma. Generalo con el mismo comando de arriba.
# JWT_SECRET_DUENO="otra-clave-larga-distinta-de-la-de-arriba"
#
# Solo para crear la cuenta la primera vez con "npm run dueno".
# Borrala del archivo apenas termines.
# CLAVE_DUENO_INICIAL="una-contrasena-larga-y-unica"
# NOMBRE_DUENO="Tu Nombre"
# ---------------------------------------------------------------------------

# Alias donde las fotocopiadoras te transfieren la suscripcion. Se muestra en
# la pantalla de Suscripcion de cada fotocopiadora. Va acá y no en el código
# porque el repositorio es público.
# ALIAS_PLATAFORMA="tu.alias.bancario"

# Almacenamiento de PDF en la nube (Vercel Blob).
# Si NO está definida, los archivos se guardan en la carpeta local
# "almacenamiento/", que es lo correcto para desarrollo.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
